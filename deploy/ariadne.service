[Unit]
Description=Ariadne AI agent service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ariadne
Group=ariadne
EnvironmentFile=-/etc/ariadne/ariadne.env
ExecStart=/usr/local/bin/ariadne serve --bind 127.0.0.1:3000 --web-dir /opt/ariadne/web
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
