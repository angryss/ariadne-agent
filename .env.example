# Default local Ollama configuration
ARIADNE_API_BASE=http://127.0.0.1:11434/v1
ARIADNE_MODEL=qwen3:8b

# Set only in your shell, service manager, or secret store when required.
# Credentials require HTTPS except for local loopback development endpoints.
# ARIADNE_API_KEY=

# Optional trusted instruction.
# ARIADNE_SYSTEM_PROMPT=You are Ariadne, a careful and capable AI software agent.

# Optional Rust diagnostics.
RUST_LOG=warn

# A separate browser/API origin requires CORS at a trusted reverse proxy.
# VITE_ARIADNE_API_URL=http://127.0.0.1:3000
